# Shared settings for static sites on this server.
# Imported before the site files because "_" sorts before letters.
# Use in a site block as:  import static_site /srv/sites/<name>
(static_site) {
	root * {args[0]}
	file_server
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Fonts never change under the same name. Everything else is revalidated,
	# so Cloudflare's edge serves the new files right after a deploy.
	@fonts path /assets/fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "public, max-age=0, must-revalidate"

	# Errors (404 and the like) must never be cached. Without this, a font requested
	# before its first deploy got a 404 with the one-year header, and Cloudflare kept serving it.
	handle_errors {
		header Cache-Control "no-store"
	}
}
